# Copy to .env.local (never commit .env.local). Values: Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Publishable key (older projects call it the "anon" key; NEXT_PUBLIC_SUPABASE_ANON_KEY also works).
# Public by design: RLS decides what it can access. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Phase 2 (all optional) ---------------------------------------------------
# PDF engine: path to Chrome/Chromium on servers/Docker. Locally run: npx playwright-core install chromium
# PDF_CHROMIUM_PATH=
# PDF_CHROMIUM_NO_SANDBOX=1      # only when running as root inside a container
# Email delivery (Resend). Server-side secrets: never prefix with NEXT_PUBLIC_.
# RESEND_API_KEY=
# EMAIL_FROM="NAFA Events <contact@nafaevents.in>"
