# Copy to .env.local (never commit .env.local). Values: Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Publishable key (older projects call it the "anon" key; NEXT_PUBLIC_SUPABASE_ANON_KEY also works).
# Public by design: RLS decides what it can access. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Phase 2 (all optional) ---------------------------------------------------
# PDF engine: path to Chrome/Chromium on servers/Docker. Locally run: npx playwright-core install chromium
# PDF_CHROMIUM_PATH=
# PDF_CHROMIUM_NO_SANDBOX=1      # only when running as root inside a container
# Email delivery (Resend). Server-side secrets: never prefix with NEXT_PUBLIC_.
# RESEND_API_KEY=
# EMAIL_FROM="NAFA Events <contact@nafaevents.in>"

# --- AI Business Development Manager -------------------------------------------
# Gemini (server-side only). Without it the dashboard still works with rule-based results.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Scheduled morning briefing: the cron route runs with the service-role key (bypasses RLS; server-only secret, never NEXT_PUBLIC_).
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=                    # any long random string; Vercel sends it as "Authorization: Bearer <secret>"
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app   # optional: link inside the morning e-mail

# --- Push notifications (mobile + desktop installed app) ---------------------------
# Generate once with: npx web-push generate-vapid-keys   (keep the private key secret; same values locally and on Vercel)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://nafa-crm.vercel.app
